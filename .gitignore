/target
**/*.rs.bk

# Captured market data never goes in git. It is large, it is reproducible
# only by re-recording (i.e. not at all), and it belongs on disk/object
# storage with its own retention policy.
/data/
/var/
*.parquet
*.zst

.env
.env.*
!.env.example

# Key files. The live path's Ed25519 private key belongs outside this
# repository, at an absolute path -- $HOME/.binance/ed25519.pem -- and is never
# made inside it (see quant-binance/src/credentials.rs). This is the second line
# of defence, not the first: it catches one made here by mistake before
# `git add .` publishes it, because this repository is public.
*.pem

# Python research environment
.venv/
__pycache__/
.ipynb_checkpoints/

# macOS Finder droppings
.DS_Store
